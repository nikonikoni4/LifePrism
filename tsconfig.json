{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@my-ui-kit/core": ["./my-ui-kit/ui-kit/index.ts"],
      "@my-ui-kit/core/*": ["./my-ui-kit/ui-kit/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}